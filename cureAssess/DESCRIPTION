Package: cureAssess
Type: Package
Title: Assessing Cure Model Appropriateness for Survival Data
Version: 0.1.0
Authors@R: c(
    person(
      given = "Geethanjalee",
      family = "Mudunkotuwa",
      role = c("aut", "cre", "cph"),
